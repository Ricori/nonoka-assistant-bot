# QQ 开放平台机器人凭证（https://q.qq.com/）
QQ_APPID=
QQ_SECRET=

# 连接模式：websocket（本地调试免公网 IP）或 webhook（需公网 HTTPS）
QQ_MODE=websocket
QQ_WEBHOOK_PORT=3000
QQ_WEBHOOK_PATH=/webhook
QQ_LOG_LEVEL=info

# 管理面板配置（非本地地址绑定时必须设置 ADMIN_TOKEN）
ADMIN_HOST=127.0.0.1
ADMIN_PORT=9617
ADMIN_TOKEN=

# 可选：自定义 Puppeteer 浏览器路径（留空则使用自带 Chromium）
PUPPETEER_EXECUTABLE_PATH=
